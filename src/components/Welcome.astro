---
import '@/styles/global.css'
import data from '@/assets/tools_list.json?raw'
import { stringToColor } from '../utils/hsl-color'

const tools = JSON.parse(data)
---

<div class='text-center h-6'>Ejeah Tools</div>
<main class='select-none'>
  <div class='waterfall p-6 pt-0 gap-6'>
    {
      Array.from({ length: 100 }, () => tools)
        .flat()
        .map((item: any) => {
          return (
            <div
              class='item cursor-pointer duration-300 ease-in-out hover:scale-105'
              style={{ backgroundColor: stringToColor(item.name) }}
            >
              <a href={item.url}>
                <div class='content px-3'>
                  <div class='text-[#402020] text-lg font-bold'>
                    {item.name}
                  </div>
                  <div class='text-[#402626]'>{item.description}</div>
                </div>
              </a>
            </div>
          )
        })
    }
  </div>
</main>

<style>
  .waterfall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    grid-auto-rows: 10px;
  }

  @media (max-width: 480px) {
    .waterfall {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function resizeGridItem(item: HTMLElement) {
    const grid = document.querySelector('.waterfall') as HTMLElement | null
    if (!grid) return

    const rowHeight = parseInt(
      getComputedStyle(grid).getPropertyValue('grid-auto-rows')
    )
    const rowGap = parseInt(getComputedStyle(grid).getPropertyValue('gap'))

    const content = item.querySelector('.content') as HTMLElement | null
    if (!content) return

    const rowSpan = Math.ceil(
      (content.getBoundingClientRect().height + rowGap) / (rowHeight + rowGap)
    )
    item.style.gridRowEnd = `span ${rowSpan}`
  }

  function resizeAllGridItems() {
    document.querySelectorAll<HTMLElement>('.item').forEach(resizeGridItem)
  }

  window.addEventListener('load', resizeAllGridItems)
  window.addEventListener('resize', resizeAllGridItems)
</script>
